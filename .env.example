# Firebase Configuration for FitMaintenance AI
# Replace with your Firebase Project credentials from the Firebase Console:
# https://console.firebase.google.com/ -> Project Settings -> General -> Your apps -> Web app

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=fitmaintenance-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fitmaintenance-ai
VITE_FIREBASE_STORAGE_BUCKET=fitmaintenance-ai.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
